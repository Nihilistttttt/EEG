<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_base"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/surface_low">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_mi_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运动想象训练"
                android:textSize="120sp"
                android:textStyle="bold"
                android:textColor="@color/training_rest" />

            <TextView
                android:id="@+id/tv_mi_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="训练由医生端控制"
                android:textSize="36sp"
                android:textColor="@color/text_secondary"
                android:paddingTop="16dp" />

            <ProgressBar
                android:id="@+id/progress_mi_trial"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="400dp"
                android:layout_height="16dp"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tv_mi_trial_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="28sp"
                android:textColor="@color/text_secondary"
                android:paddingTop="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:gravity="center"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mi_start_training"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="开始MI训练"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mi_stop_training"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="停止"
            android:textSize="16sp"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
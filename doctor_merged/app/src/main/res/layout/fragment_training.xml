<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_base"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/surface_low">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/layout_idle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_trial_direction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="准备开始"
                    android:textSize="80sp"
                    android:textStyle="bold"
                    android:textColor="@color/training_rest" />

                <TextView
                    android:id="@+id/tv_trial_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击下方按钮开始训练"
                    android:textSize="18sp"
                    android:textColor="@color/text_secondary"
                    android:paddingTop="12dp" />

                <ProgressBar
                    android:id="@+id/progress_trial"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="400dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="24dp"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:id="@+id/tv_trial_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_ssvep"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_ssvep_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←"
                    android:textSize="160sp"
                    android:textStyle="bold"
                    android:textColor="@color/direction_left" />

                <TextView
                    android:id="@+id/tv_ssvep_freq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 Hz"
                    android:textSize="24sp"
                    android:textColor="@color/text_secondary"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/tv_ssvep_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="注视闪烁箭头"
                    android:textSize="18sp"
                    android:textColor="@color/text_secondary"
                    android:paddingTop="12dp" />
            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_training"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="开始训练"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stop_training"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="停止"
            android:textSize="16sp"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>

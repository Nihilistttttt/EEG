<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="6dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/surface_mid"
        app:strokeColor="@color/surface_overlay"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:text="波形"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_wave_type"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="滤波" />

            <TextView
                android:text="Y轴"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tv_y_range"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100μV" />

            <TextView
                android:text="X轴"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tv_x_range"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.05 s" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_resume"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="52dp"
                android:layout_marginStart="4dp"
                android:text="暂停"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_ip"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="52dp"
                android:layout_marginStart="4dp"
                android:text="UDP"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_training"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="52dp"
                android:layout_marginStart="4dp"
                android:text="训练"
                android:textSize="12sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.nihilisttt.eegdoctor.EegStripView
        android:id="@+id/eeg_strip_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
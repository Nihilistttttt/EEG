<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <TextView
        android:id="@+id/tv_stroop_word"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="等待开始"
        android:textSize="120sp"
        android:textStyle="bold"
        android:textColor="#FF90A4AE" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#AA000000"
        android:padding="10dp">

        <TextView
            android:id="@+id/btn_focus_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="开始训练"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF69F0AE"
            android:padding="10dp" />

        <TextView
            android:id="@+id/btn_focus_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="停止训练"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFF5252"
            android:alpha="0.5"
            android:padding="10dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#AA000000"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_focus_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="未开始"
            android:textColor="#FFEEEEEE"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_focus_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="专注度: --"
            android:textColor="#FFB0BEC5"
            android:textSize="14sp"
            android:paddingTop="4dp" />
    </LinearLayout>
</FrameLayout>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface_low"
                app:strokeColor="@color/surface_overlay"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:background="@color/surface_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="4dp"
                            android:background="@color/wave_ch0" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fp1"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/attn_ch0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="专注度: --"
                            android:textColor="@color/focus_line"
                            android:textSize="10sp" />

                        <View
                            android:id="@+id/signal_quality_ch0"
                            android:layout_width="20dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="6dp"
                            android:background="@color/accent_success" />
                    </LinearLayout>

                    <com.nihilisttt.udptest.WaveformView
                        android:id="@+id/wave_ch0"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:waveColor="@color/wave_ch0"
                        app:channelIndex="0" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface_low"
                app:strokeColor="@color/surface_overlay"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:background="@color/surface_mid"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="4dp"
                            android:background="@color/wave_ch1" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fp2"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/attn_ch1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="专注度: --"
                            android:textColor="@color/focus_line"
                            android:textSize="10sp" />

                        <View
                            android:id="@+id/signal_quality_ch1"
                            android:layout_width="20dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="6dp"
                            android:background="@color/accent_success" />
                    </LinearLayout>

                    <com.nihilisttt.udptest.WaveformView
                        android:id="@+id/wave_ch1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:waveColor="@color/wave_ch1"
                        app:channelIndex="1" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface_low"
                app:strokeColor="@color/surface_overlay"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:background="@color/surface_mid"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:text="频谱 Ch0"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.nihilisttt.udptest.SpectrumView
                        android:id="@+id/spectrum_ch0"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:spectrumColor="@color/spectrum_bar"
                        app:spectrumColorEnd="@color/spectrum_bar_end" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface_low"
                app:strokeColor="@color/surface_overlay"
                app:strokeWidth="0.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:background="@color/surface_mid"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:text="频谱 Ch1"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.nihilisttt.udptest.SpectrumView
                        android:id="@+id/spectrum_ch1"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:spectrumColor="@color/spectrum_bar"
                        app:spectrumColorEnd="@color/spectrum_bar_end" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="6dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/surface_mid"
        app:strokeColor="@color/surface_overlay"
        app:strokeWidth="0.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/status_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_status_indicator" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="等待连接..."
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:text="X轴"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_x_range"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.05 s" />

            <TextView
                android:text="波形"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tv_wave_label_count"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="7" />

            <TextView
                android:text="x"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_wave_range"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500uV" />

            <TextView
                android:text="频谱"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tv_spectrum_range"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500 uV" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/surface_overlay" />

            <TextView
                android:id="@+id/tv_instant_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="瞬时: -"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_trend_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="趋势: -"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_resume"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="52dp"
                android:text="暂停"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_ip"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="52dp"
                android:layout_marginStart="4dp"
                android:text="UDP"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_car_game"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="52dp"
                android:layout_marginStart="4dp"
                android:text="训练"
                android:textSize="12sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

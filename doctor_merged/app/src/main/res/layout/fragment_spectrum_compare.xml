<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="@color/surface_base">

    <LinearLayout
        android:id="@+id/grid_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="6dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/surface_mid"
        app:strokeColor="@color/surface_overlay"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:text="频谱"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_spec_range"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500 uV" />

            <TextView
                android:text="Hz"
                style="@style/ControlLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/tv_spec_x_range"
                style="@style/ParamChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0-125" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_channel_cfg"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="52dp"
                android:layout_marginStart="4dp"
                android:text="通道"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_resume"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="52dp"
                android:layout_marginStart="4dp"
                android:text="暂停"
                android:textSize="12sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
